//质数的计数与求和

#include <stdio.h>
#include <math.h>

void clear_input_buffer(void) {
	int c;
	while ((c = getchar()) != '\n' && c != EOF) {
		; // 什么都不做，只是把字符丢掉
	}
}

int main(void) {

	int input1 = 0,input2=0;

	while (1) {

		printf("please type two numbers:(example:a b)");

		int result= scanf_s("%d %d", &input1,&input2);

		if (result == 2) {
			if (input1>=1&&input1<=500&&input2>=1&&input2<=500&&input1!=input2) {

				break;
			}

			else {

				printf("please type again, the input must be a number larger than 1 or equal to 1 ,smaller than 500 or equal to 500\nand the numbers should be different from each other");

				continue;
			}
		}
		else {

			printf("please type again, the input must be a number!\n");

			clear_input_buffer();

			continue;

		}

	}

	int max = 0;

	int min = 0;
	if (input1>input2) {

		max = input1;

		min = input2;
	}

	else {

		max = input2;

		min = input1;
	}

	int sum = 0;

	int count = 0;

	for (int number=min;number>=min&&number<=max;number++) {
		int tempo = (int)sqrt((double)number);

		int sign = 1;

		for (;tempo >1;tempo--) {

			if (number%tempo==0) {

				sign = 0;

				break;
			}

			else {
				continue;

			}
		}

		if (sign == 1) {

			count++;

			sum = sum + number;
		}

		else {
			continue;

		}
	}

	printf("%d %d",count,sum);


	return 0;
	

}

