#include <stdio.h>

int main() {

	int n = 0;

	int result = 0;

	while (1) {

		printf("please type a number\n");

		scanf_s("%d", &n);

		if (n < 0) {

			printf("Type again. the number should be larger than 0\n");

			continue;
		}

		if (n == 0) {

			printf("Type again. the number should be larger than 0\n");

			continue;
		}

		if (n > 0) {
			
			do {

				result = n % 10;

				printf("%d", result);

				n = n / 10;
			} while (n > 0);

				break;
		}
	}
	return 0;

}

