
#include <stdio.h>
#include <string.h>

int main()
{
    char word[100] = { 0 };

    int n = 0;

    
    scanf_s("%d", &n);

    scanf_s("%s", word, 100);

 
    for (int i = 0; i < strlen(word); i++) {
       
        if (word[i] >= 'a' && word[i] <= 'z') {
            

            if (word[i] + n>122) {
                word[i] = word[i] + n - 26;
            }

            else {

                word[i] = word[i] + n;
            }
        }
    }

    printf("%s\n", word);

    return 0;
}
