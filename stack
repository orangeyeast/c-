//栈

#include<stdio.h>

int main() {

	int n = 0;

	scanf_s("%d", &n);

	int number[19][19] = { 0 };

	for (int i = 0; i <= n; i++) {

		for (int j = 0;j <= n && j <= i;j++) {

			if (i==0 && j!=0) {

				number[i][j] = number[i][j - 1] ;
			}

			else if(j==0 && i!=0){

				number[i][j] = number[i - 1][j];
			}

			else if (i==0&&j==0) {

				number[0][0] = 1;
			}

			else {
				number[i][j] = number[i][j - 1] + number[i - 1][j];
			}
		}
	}

	printf("%d", number[n][n]);

	return 0;
}
