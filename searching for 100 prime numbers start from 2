
#include <stdio.h>

int isPrime(int x, int primes[],int numberOfKnownPrimes);

int main()
{
    int prime[100] = { 2 };

    int count = 1;

    int tempo = 3;

    while (count < 100) {
        if (isPrime(tempo,prime,count) ){
            prime[count++]=tempo;

        }

        tempo++;

    }

    for (tempo = 0;tempo < 100;tempo++) {

        printf("%d", prime[tempo]);

        if ((tempo + 1) % 5)printf("\t");

        else printf("\n");
    }



}

int isPrime(int x, int primes[], int numberOfKnownPrimes) {

    int ret = 1;

    int i;

    for (i = 0;i < numberOfKnownPrimes;i++) {

        if (x%primes[i] == 0) {

            ret = 0;
        }
    }

    return ret;
}


