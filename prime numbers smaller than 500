
#include <stdio.h>

int main()
{
    //MSVC can't use a variable to define a array,so i'll use a number to replace it
    int prime[500] = {0};

    int i = 0;

    for (i = 0;i < 500;i++) {

        prime[i] = 1;
    }

    int count = 2;

    int tempo = 2;

    for (tempo = 2;tempo < 500;tempo++) {
        if (prime[tempo-1]==1) {

            for (count = 2;count * tempo < 500;count++) {
                prime[count * tempo -1] = 0;

            }
        }

    }

    int digit = 0;

    for (tempo = 1;tempo < 500;tempo++) {
        if (prime[tempo]) {

            printf("%d", tempo + 1);

            digit = digit + 1;

            if (digit % 5 == 0) {

                printf("\n");
            }

            else {

                printf("\t");
            }

        }
        
    }

    return 0;

}



