
#include <stdio.h>

int digit[10];   // 存储 n 的每一位，高位在前
int x, len;      // x 是目标数字，len 是 n 的位数

// pos: 当前处理到第几位（从高位到低位）
// limit: 是否受到 n 的限制
// lead: 是否还在前导零
// cnt: 到目前为止 x 出现的次数
int dfs(int pos, int limit, int lead, int cnt) {
    if (pos == len) return cnt;          // 所有位处理完，返回累计次数

    int up = limit ? digit[pos] : 9;     // 当前位能取的最大值
    int res = 0;

    for (int i = 0; i <= up; i++) {
        if (lead && i == 0) {
            // 仍然处于前导零，当前位的 0 不算作数字 0
            res += dfs(pos + 1, limit && (i == up), 1, cnt);
        }
        else {
            // 当前位是有效数字
            int add = (i == x) ? 1 : 0;
            res += dfs(pos + 1, limit && (i == up), 0, cnt + add);
        }
    }
    return res;
}

int count(int n, int xx);

int main() {
    int n, xx;

    scanf_s("%d %d", &n, &xx);   
    
    // 洛谷不能用 scanf_s

    printf("%d\n", count(n, xx));

    return 0;
}

int count(int n, int xx) {
    x = xx;

    len = 0;

    while (n > 0) {
        digit[len++] = n % 10;
        n /= 10;
    }

    // 反转 digit，使高位在前
    for (int i = 0; i < len / 2; i++) {
        int t = digit[i];
        digit[i] = digit[len - 1 - i];
        digit[len - 1 - i] = t;
    }

    return dfs(0, 1, 1, 0);   // 从最高位开始，受限制，是前导零，计数为 0

}
