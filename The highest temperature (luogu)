
#include <stdio.h>

//scanf_s改成scanf 洛谷

int main()
{
    int N = 0;

    scanf_s("%d", &N);

    int yesterday = 0;

    int today = 0;

    int count = 0;

    int Max = 0;

    for (int temp = N;temp > 0;temp--) {

        scanf_s("%d", &today);

        if (today>yesterday) {

            count++;

            yesterday = today;
        }

        else {
            if (count>Max) {

                Max = count;
            }

            
            count = 0;

            yesterday = today;
        }

    }

    if (count > Max) {

        Max = count;

    }

    printf("%d", Max+1);

    return 0;
}

   
