#include <stdio.h>

int main()
{
    char input = '0';

    while (input!='#') {

        scanf_s("%c",&input);

        int number = input;

        if (input=='#') {

            break;
        }

        else if (number>=65&&number<=90) {

            input = input + 32;

            printf("%c",input);
        }

        else if (number >= 97 && number <= 122) {

            input = input - 32;

            printf("%c", input);
        }

        else {

            printf("%c",input);
        }
    }

    return 0;

}
