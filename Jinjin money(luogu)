
#include<stdio.h>
//为了适应洛谷的评分标准，需要把scanf_s改成scanf
int main() {

	int total = 0;

	int money = 0;

	int pay = 0;

	int deposit = 0;

	for (int temp = 0;temp < 12;temp++) {
		
		scanf_s("%d",&pay);

		total = money + 300 - pay;

		money = (money + 300 - pay) % 100;

		deposit = deposit + total-money;

		if (total<0) {
			printf("-%d",temp+1);

			return 0;

		}

	}

	printf("%d", deposit/100*120 + money);
	
	return 0;
}

