
#include<stdio.h>

int main() {
	int total = 0;

	double money = 0;

	scanf_s("%d", &total);

	if (total<=150) {
		
		money = 0.4463 * total;
	}

	else if (total>=151&&total<=400) {
		money = 0.4663 * (total - 150) + 66.945;

	}
	
	else if (total>=401) {
		money = 183.52 + (total - 400) * 0.5663;

	}

	printf("%.1f", money);
	return 0;


}
