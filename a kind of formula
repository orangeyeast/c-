//九九乘法表

#include <stdio.h>

void clear_input_buffer(void) {
	int c;
	while ((c = getchar()) != '\n' && c != EOF) {
		; // 什么都不做，只是把字符丢掉
	}
}

int main(void) {

	int input = 0;

	while (1) {

		printf("please type a number:");

		int result= scanf_s("%d", &input);

		if (result == 1) {
			if (input>=1&&input<=9) {

				break;
			}

			else {

				printf("please type again, the input must be a number larger than 1 or equal to 1 ,smaller than 9 or equal to 9\n");

				continue;
			}
		}
		else {

			printf("please type again, the input must be a number!\n");

			clear_input_buffer();

			continue;

		}

	}

	for (int num2 = 1; num2 <= input; num2++) {

		for (int num1 = 1;num1 <= num2; num1++) {

			if (num1==num2) {

				printf("%d*%d=%d\n",num1,num2,num1*num2);

			}

			else {
				printf("%d*%d=%d ", num1, num2, num1 * num2);

			}
		}
	}

	return 0;
	

}

