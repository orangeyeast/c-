
#include<stdio.h>

int main() {

	int x = 0;

	int y = 0;

	int z = 0;


	for (x=102;x >= 102 && x <= 333;x++) {

		y = x * 2;

		z = x * 3;

		int x100 = x / 100;

		int x10 = (x - x100 * 100) / 10;

		int x1 = x - x100 * 100 - x10 * 10;

		int y100 = y / 100;

		int y10 = (y - y100 * 100) / 10;

		int y1 = y - y100 * 100 - y10 * 10;

		int z100 = z / 100;

		int z10 = (z - z100 * 100) / 10;

		int z1 = z - z100 * 100 - z10 * 10;

		if (
			x100 == 0 || x10 == 0 || x1 == 0 ||
			y100 == 0 || y10 == 0 || y1 == 0 ||
			z100 == 0 || z10 == 0 || z1 == 0
			) {
			continue;
		}

		if (
			x100 != x10 && x100 != x1 && x100 != y100 && x100 != y10 && x100 != y1 && x100 != z100 && x100 != z10 && x100 != z1 &&
			x10 != x1 && x10 != y100 && x10 != y10 && x10 != y1 && x10 != z100 && x10 != z10 && x10 != z1 &&
			x1 != y100 && x1 != y10 && x1 != y1 && x1 != z100 && x1 != z10 && x1 != z1 &&
			y100 != y10 && y100 != y1 && y100 != z100 && y100 != z10 && y100 != z1 &&
			y10 != y1 && y10 != z100 && y10 != z10 && y10 != z1 &&
			y1 != z100 && y1 != z10 && y1 != z1 &&
			z100 != z10 && z100 != z1 &&
			z10 != z1
			) {
			printf("%d %d %d\n", x, y, z);
		}

		else {
			continue;
		}
	}

	return 0;
}
