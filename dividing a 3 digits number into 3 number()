//排列三位数

#include <stdio.h>

void clear_input_buffer(void) {
	int c;
	while ((c = getchar()) != '\n' && c != EOF) {
		; // 什么都不做，只是把字符丢掉
	}
}

int main(void) {

	int input = 0;

	while (1) {

		printf("please type a number:");

		int result= scanf_s("%d", &input);

		if (result == 1) {
			if (6>=input&&input>=1) {

				break;
			}

			else {

				printf("please type again, the input must be a number larger than 1 or equal to 1 ,smaller than6 or equal to 6\n");

				continue;
			}
		}
		else {

			printf("please type again, the input must be a number!\n");

			clear_input_buffer();

			continue;

		}

	}

	int first, second, third;

	int count = 0;

	for (first = input;first <= input + 3; first++) {
		for (second = input;second <= input + 3; second++) {
			for (third = input;third <= input + 3;third++) {
				if (first!=second&&second!=third&&first!=third) {
					printf("%d%d%d",first,second,third);

					count++;

					if (count % 6 == 0) {

						printf("\n");
					}

					else {
						printf(" ");

					}

				}
			}

		}
	}
	

}

