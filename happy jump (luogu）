//欢乐的跳
#include<stdio.h>

#include<stdlib.h>
//洛谷不能用scanf_s

int main() {

	int total[1000] = { 0 };

	int n = 0;

	int lastNumber = 0;

	int theNumber = 0;

	scanf_s("%d", &n);

	for (int i = 0;i < n;i++) {
		if (i==0) {

			scanf_s("%d", &theNumber);

			lastNumber = theNumber;

		}

		else {

			scanf_s("%d", &theNumber);
			if (abs(theNumber - lastNumber) > n - 1) {
				printf("Not jolly");

				return 0;

			}

			else if(total[abs(theNumber-lastNumber)]==0) {

				total[abs(theNumber - lastNumber)] = 1;

				lastNumber = theNumber;
			}

			else {

				printf("Not jolly");

				return 0;
			}
		}

	}

	printf("Jolly");

	return 0;

}
