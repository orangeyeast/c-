
#include <stdio.h>

//scanf_s改成scanf 洛谷

int main()
{
    char word[50] = {'0'};

    int n = 0;

    scanf_s("%d", &n);

    getchar();

    for (int i = 0;i < 50;i++) {
        int ret=scanf_s("%c",&word[i],1);

        if (ret !=1 || word[i]=='\n') {

            break;
        }

    }

    for (int i2 = 0;i2 < 50;i2++) {
        if (word[i2]!='\n') {

            if (word[i2] + n > 122) {
                word[i2] = word[i2] + n - 26;
            }

            else {
                word[i2] = word[i2] + n;

            }

           
        }

        if (word[i2] == '\n') {
            break;

        }
    }

    for (int temp = 0;temp<50;temp++) {
        if (word[temp] != '0') {
            printf("%c", word[temp]);
        }

        else {

            break;
        }
    }

    return 0;
}

   
