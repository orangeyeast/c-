

#include <stdio.h>

#include <math.h>

void clear_input_buffer(void) {
	int c;
	while ((c = getchar()) != '\n' && c != EOF) {
		; // 什么都不做，只是把字符丢掉
	}
}

int main(void) {

	int input = 0;

	while (1) {

		printf("please type a number:");

		int result= scanf_s("%d", &input);

		if (result == 1) {
			if (input>=2) {

				break;
			}

			else {

				printf("please type again, the input must be a number larger than 1\n");

				continue;
			}
		}
		else {

			printf("please type again, the input must be a number!\n");

			clear_input_buffer();

			continue;

		}

	}

	for (int variable = 2; variable <= input; variable++) {

		int isPrime = 0;

		int n = (int)sqrt(variable);

		while (n>1) {

			if (variable%n==0) {

				isPrime = 1;

				break;
			}

			else {

				n = n - 1;
			}
		}
		if (isPrime == 1) {
			continue;

		}

		else {

			printf("%d ",variable);

			continue;
		}
	}

	return 0;

}

