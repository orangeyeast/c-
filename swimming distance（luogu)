
#include <stdio.h>

//scanf_s改成scanf 洛谷

int main()
{
    int input = 0;

    int days = 0;

    int total = 0;

    scanf_s("%d %d", &input, &days);

    for (int i = input;i<input+days;i++) {
        if (i%7==6||i%7==0) {

            total = total;
        }

        else {

            total += 250;
        }

    }

    printf("%d", total);

    return 0;
}

