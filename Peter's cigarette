
#include<stdio.h>

//洛谷不能用scanf_s

int main() {
	int n = 0;

	int k = 0;

	int count = 0;

	int left = 0;

	scanf_s("%d %d", &n, &k);

	while (n+left >= k) {

		int p = n + left ;

		count = count + n; 

		n = (n+left) / k;

		left = p % k ;
	}

	count = count + n;

	printf("%d", count);

	return 0;

}
