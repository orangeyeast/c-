
#include <stdio.h>

#include <stdlib.h>

int cmp(const void* a, const void* b);
//scanf_s改成scanf 洛谷

int main()
{
    int level[10001] = { 0 };

    int number = 0;

    scanf_s("%d", &number);

    for (int temp1 = number;temp1 > 0;temp1--) {

        scanf_s("%d", &level[temp1]);
    }
    
    qsort(level,10001,sizeof(int),cmp);

    int max = level[10000];

    int count = 0;

    for (int i = 10000;i > 0;i--) {

        if (level[i]!=level[i-1]) {
            if (level[i] != 0) {
                count++;
            }
        }
    }


    printf("%d",number+count*5+max*10 );


    return 0;
}

int cmp(const void* a, const void*b) {
    int x = *(const int*)a;

    int y = *(const int*)b;

    if (x<y) {

        return -1;
    }

    if (x > y) {

        return 1;
    }

    return 0;
}
