#include <stdio.h>

void clear_input_buffer(void) {
	int c;
	while ((c = getchar()) != '\n' && c != EOF) {
		; // 什么都不做，只是把字符丢掉
	}
}

int main(void) {

	int input1 = 0;

	int input2 = 0;

	while (1) {

		printf("please type two numbers:(example: a b)");

		int result= scanf_s("%d %d", &input1,&input2);

		if (result == 2) {
			if (input1>=1&&input2>=1) {

				break;
			}

			else {

				printf("please type again, the input must be a number larger than 1 or equal to 1\n");

				continue;
			}
		}
		else {

			printf("please type again, the input must be a number!\n");

			clear_input_buffer();

			continue;

		}

	}

	int min = 0;

	if (input1>input2) {

		min = input2;
	}

	else{
		
		min = input1;
	}

	for (;min > 0;min--) {
		if (input1%min==0&&input2%min==0) {

			printf("the GCD of %d and %d is %d", input1, input2, min);

			break;
		}

	}

	return 0;

}

