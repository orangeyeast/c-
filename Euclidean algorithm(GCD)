//最大公约数（辗转相除法）
#include <stdio.h>

void clear_input_buffer(void) {
	int c;
	while ((c = getchar()) != '\n' && c != EOF) {
		; // 什么都不做，只是把字符丢掉
	}
}

int main(void) {

	int input1 = 0;

	int input2 = 0;

	while (1) {

		printf("please type two numbers:(example: a b)");

		int result= scanf_s("%d %d", &input1,&input2);

		if (result == 2) {
			if (input1>=1&&input2>=1) {

				break;
			}

			else {

				printf("please type again, the input must be a number larger than 1 or equal to 1\n");

				continue;
			}
		}
		else {

			printf("please type again, the input must be a number!\n");

			clear_input_buffer();

			continue;

		}

	}

	int t = 0;

	int tem1, tem2;

	tem1 = input1;
	
	tem2 = input2;

	while (input2!=0) {

		t = input1 % input2;

		input1 = input2;

		input2 = t;

	}

	printf("the CGD of %d and %d is %d", tem1,tem2,input1);

	return 0;

}

